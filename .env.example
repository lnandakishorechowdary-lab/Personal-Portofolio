# EmailJS Configuration for Portfolio Contact Form
# Sign up for free at https://www.emailjs.com/
# NEVER commit your real credentials or .env file to version control.

# EmailJS Service ID (Created under Email Services in EmailJS dashboard, e.g. service_xxxxxxx)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id

# EmailJS Template ID (Created under Email Templates in EmailJS dashboard, e.g. template_xxxxxxx)
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id

# EmailJS Public Key (Found in Account > API Keys > Public Key, e.g. user_xxxxxxx or your_public_key)
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
